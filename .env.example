# Скопируй в .env и заполни реальными значениями. Никогда не коммить .env.

# Postgres — Supabase Transaction pooler (aws-N-region.pooler.supabase.com:6543), НЕ direct connection
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Auth
JWT_SECRET=
IIKO_CRED_KEY=

# WebAuthn (passkeys)
RP_ID=localhost
RP_NAME=Lokmaco
RP_ORIGIN=http://localhost:3000

# iiko Server (XML API) — глобальный фолбэк, per-filial креды хранятся в БД (filials.iiko_creds, шифрованы IIKO_CRED_KEY)
IIKO_SERVER=
IIKO_LOGIN=
IIKO_PASSWORD=
IIKO_REJECT_UNAUTHORIZED=true

# iiko Web (JSON API)
IIKO_WEB_URL=
IIKO_WEB_LOGIN=
IIKO_WEB_PASSWORD=

# iiko Web Configuration IDs
IIKO_CONCEPTION_ID=
IIKO_CONTAINER_ID=
IIKO_STORE_NUM=
IIKO_KITCHEN_PREP_STORE=

# Legacy Supabase (только для одноразовой миграции данных, не для рантайма)
SUPABASE_URL=
SUPABASE_KEY=

# Telegram (уведомления, опционально)
TG_BOT_TOKEN=
TG_CHAT_ID=

# OpenRouter (AI-парсинг накладных)
OPENROUTER_API_KEY=

# Claude API — ассистент-аналитик (/dashboard/assistant, только для admin)
ANTHROPIC_API_KEY=

# Приём сканов накладных с почты (/api/inbound/scan?secret=...).
# Ручка живёт вне сессии — сюда стучится почтовый провайдер, а не человек,
# поэтому секрет обязателен: без него приём выключен (503).
INBOUND_SCAN_SECRET=

# Запуск рассылки закупа планировщиком Vercel (Authorization: Bearer ...).
CRON_SECRET=

# Группа Telegram под закуп. Если не задана — берётся общий TG_CHAT_ID.
TG_PURCHASES_CHAT_ID=
